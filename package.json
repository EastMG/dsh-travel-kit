  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EastMG/dsh-travel-kit.git"
  },
  "bugs": {
    "url": "https://github.com/EastMG/dsh-travel-kit/issues"
  },
  "homepage": "https://github.com/EastMG/dsh-travel-kit#readme",
  "bin": {
    "dsh-travel": "bin/dsh-travel.js"
  },
  "files": [
    "bin",
    "skills",
    "scripts/install.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "test:doctor": "node bin/dsh-travel.js doctor"
  },
  "engines": {
